// Heeca Beauty — Sistema de gestão para salões de beleza
// Arquitetura multi-tenant: todas as entidades de negócio pertencem a um Tenant.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Tenant / Auth ─────────────────────────

model Tenant {
  id           String  @id @default(cuid())
  marca        String   @default("beauty") // produto do motor multi-marca (beauty | wellness) — lib/marca.ts
  segmentos    String[] @default([]) // segmentos que o estabelecimento atende (slugs de marca.segmentos); vazio = ainda não escolheu
  salasAtivas  Boolean  @default(false) // agenda por sala e recursos (spa, clínica): liga o cadastro de salas e o "onde" no serviço
  slug         String  @unique // app.com.br/agendar/<slug>
  businessName String
  ownerName    String
  description  String?
  logoUrl      String?
  phone        String? // WhatsApp do estabelecimento (E.164)
  address      String?
  city         String?
  instagram    String? // handle sem @ (ex.: "salaobelavista")
  timezone     String  @default("America/Sao_Paulo")

  // Cadastro do salão (SPEC §4)
  legalName    String? // razão social
  cnpj         String? // só dígitos
  email        String?
  website      String?
  photoUrls    String[] @default([]) // fotos do espaço na página pública
  openingHours String? // texto livre: "Ter–Sáb 9h às 19h" (a agenda real é por profissional)
  extraInfo    String? // informações adicionais (estacionamento, acessibilidade…)

  // Regras de agenda (configuráveis pelo profissional)
  slotIntervalMinutes         Int     @default(15) // granularidade dos horários exibidos
  bufferMinutes               Int     @default(0) // tempo mínimo entre agendamentos
  minAdvanceMinutes           Int     @default(60) // antecedência mínima para agendar
  maxAdvanceDays              Int     @default(60) // até quantos dias à frente
  pendingExpiryMinutes        Int? // libera horário se não confirmado em X min (null = nunca)
  cancelDeadlineHours         Int     @default(2) // cliente pode cancelar até X horas antes
  reminderHoursBefore         Int     @default(24)
  requireWhatsappConfirmation Boolean @default(true)
  maxConcurrentAppointments   Int     @default(1)
  maxDailyAppointments        Int? // limite de atendimentos por dia por profissional (null = sem limite)

  // Políticas de atendimento (seção 14) — exibidas na página pública e aceitas pela cliente
  lateToleranceMinutes    Int     @default(10) // tolerância de atraso
  cancellationPolicy      String? // texto livre: política de cancelamento
  noShowPolicy            String? // texto livre: política para não comparecimento
  reschedulePolicy        String? // texto livre: prazo/regras de reagendamento
  companionsAllowed       Boolean @default(true) // proibição de acompanhantes, se aplicável
  preServiceInstructions  String? // orientações pré-atendimento (vão no WhatsApp de confirmação/lembrete)
  requirePolicyAcceptance Boolean @default(true) // cliente precisa marcar "li e aceito" ao agendar

  // Pagamento antecipado (sinal) via Pix
  depositMode           DepositMode @default(NONE)
  depositValue          Int         @default(0) // PERCENT: 0..100 · FIXED: centavos
  depositTimeoutMinutes Int         @default(30) // libera o horário se não pagar em X min
  pixProvider           String? // "mercadopago" (null = usa PIX_PROVIDER do ambiente)
  pixCredentialsEnc     String? // access token do provedor, criptografado (AES-256-GCM)

  // Vínculo com o portal heeca.com.br (dono de conta, plano e cobrança — contrato em heeca_site/docs/ENTITLEMENT.md).
  // Só espelho: o Nail nunca cobra. null = tenant criado pelo cadastro local (sem assinatura no portal).
  heecaSubscriptionId String?   @unique
  heecaAccountId      String?
  heecaPlan           String? // código do plano no portal (ex.: "solo", "studio")
  heecaStatus         String? // TRIALING | ACTIVE | PAST_DUE | SUSPENDED | CANCELED
  heecaBlocked        Boolean   @default(false) // access === "blocked" no portal → painel bloqueado
  heecaSyncedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  professionals     Professional[]
  categories        ServiceCategory[]
  services          Service[]
  clients           Client[]
  appointments      Appointment[]
  appointmentItems  AppointmentItem[]
  availability      AvailabilityRule[]
  exceptions        ScheduleException[]
  blocks            ScheduleBlock[]
  rooms             Room[]
  resources         Resource[]
  messages          WhatsappMessage[]
  templates         MessageTemplate[]
  appointmentEvents AppointmentEvent[]
  payments          Payment[]
  portfolio         PortfolioItem[]

  @@index([marca])
}

enum DepositMode {
  NONE // sem pagamento antecipado
  PERCENT // percentual do valor do serviço
  FIXED // valor fixo em centavos
}

enum UserRole {
  OWNER // dono: tudo
  MANAGER // gerente: gestão operacional e financeira, sem acessos/pagamentos
  RECEPTION // recepção: agenda e clientes de toda a equipe
  STAFF // profissional: só a própria agenda
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(OWNER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional Professional?
  resetTokens  PasswordResetToken[]

  @@index([tenantId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Quem atende. Um salão tem vários (equipe), cada um com a própria agenda (SPEC §5).
model Professional {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String?  @unique
  name        String
  photoUrl    String?
  bio         String?
  phone       String? // E.164
  email       String?
  specialties String? // texto livre: "Cabeleireira, colorista"
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)

  // Comissão padrão do profissional (SPEC §17). Pode ser sobrescrita por serviço em ProfessionalService.
  // null = não comissionado (ex.: dono do salão). Percentual inteiro 0..100.
  commissionPercent Int?

  createdAt DateTime @default(now())

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  items            AppointmentItem[]
  availability     AvailabilityRule[]
  exceptions       ScheduleException[]
  blocks           ScheduleBlock[]
  services         ProfessionalService[]
  preferredByClients Client[]            @relation("ClientPreferredProfessional")

  @@index([tenantId])
}

// ───────────────────────── Serviços ─────────────────────────

// Categorias criadas pelo salão (SPEC §7). O seed cria as cinco padrão
// (Cabelo, Unhas, Sobrancelhas, Cílios, Estética); o salão edita e acrescenta.
model ServiceCategory {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  slug      String // estável para URLs/âncoras na página pública
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services  Service[]
  portfolio PortfolioItem[]

  @@unique([tenantId, slug])
  @@index([tenantId, sortOrder])
}

model Service {
  id              String          @id @default(cuid())
  tenantId        String
  categoryId      String?
  name            String
  description     String?
  clientNotes     String? // observações importantes para a cliente (ex.: "vir sem esmalte")
  durationMinutes Int
  priceCents      Int
  // Adicional (seção 6.3): não é agendado sozinho; a cliente marca junto com um procedimento
  // principal e ele soma tempo e preço ao agendamento.
  isAddOn         Boolean         @default(false)
  active          Boolean         @default(true)
  imageUrl        String?
  // Sala e recursos (opção salasAtivas do tenant). roomRequired = precisa de uma sala livre;
  // `rooms` vazio = qualquer sala ativa serve; com itens = só aquelas. Preparo/limpeza ocupam a sala e os
  // recursos (não o profissional).
  roomRequired        Boolean @default(false)
  bufferBeforeMinutes Int     @default(0)
  bufferAfterMinutes  Int     @default(0)
  sortOrder       Int             @default(0)
  deletedAt       DateTime? // soft delete: agendamentos antigos continuam referenciando
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category      ServiceCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  items         AppointmentItem[]
  addOnUsages   AppointmentAddOn[]
  professionals ProfessionalService[]
  rooms         ServiceRoom[]
  resources     ServiceResource[]

  @@index([tenantId, active, sortOrder])
  @@index([tenantId, categoryId])
}

// ───────── Salas e recursos (agenda por sala: spa, clínica de estética) ─────────

model Room {
  id          String   @id @default(cuid())
  tenantId    String
  name        String // "Sala 01"
  kind        String? // "Massagem", "Casal", "Estética"…
  capacity    Int      @default(1)
  description String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services ServiceRoom[]
  items    AppointmentItem[]
  blocks   ScheduleBlock[]

  @@index([tenantId, active, sortOrder])
}

/** Recurso compartilhado com quantidade (banheira, sauna, macas): consumido pelos serviços enquanto acontecem. */
model Resource {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  quantity    Int      @default(1)
  description String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services     ServiceResource[]
  reservations AppointmentItemResource[]
  blocks       ScheduleBlock[]

  @@index([tenantId, active, sortOrder])
}

model ServiceRoom {
  serviceId String
  roomId    String

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  room    Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([serviceId, roomId])
  @@index([roomId])
}

model ServiceResource {
  serviceId  String
  resourceId String
  quantity   Int    @default(1)

  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([serviceId, resourceId])
  @@index([resourceId])
}

/** Unidades de um recurso reservadas por um item da visita (snapshot do ServiceResource ao agendar). */
model AppointmentItemResource {
  id         String @id @default(cuid())
  itemId     String
  resourceId String
  quantity   Int    @default(1)

  item     AppointmentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  resource Resource        @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([itemId, resourceId])
  @@index([resourceId])
}

// Adicionais escolhidos junto de um serviço da visita, com snapshot de nome/tempo/preço.
// Somam ao durationMinutes/priceCents do AppointmentItem a que pertencem.
model AppointmentAddOn {
  id              String @id @default(cuid())
  itemId          String
  serviceId       String
  name            String
  durationMinutes Int
  priceCents      Int

  item    AppointmentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  service Service         @relation(fields: [serviceId], references: [id])

  @@index([itemId])
}

// Quais serviços cada profissional executa (N:N).
model ProfessionalService {
  professionalId String
  serviceId      String

  // Comissão específica deste par (SPEC §17). null = usa Professional.commissionPercent.
  commissionPercent    Int? // 0..100
  commissionFixedCents Int? // valor fixo por execução; tem precedência sobre o percentual

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
  @@index([serviceId])
}

// ───────────────────────── Agenda / Disponibilidade ─────────────────────────

// Horário semanal recorrente. Uma linha por dia da semana (0 = domingo).
model AvailabilityRule {
  id                String @id @default(cuid())
  tenantId          String
  professionalId    String
  weekday           Int // 0..6
  startMinutes      Int // minutos desde 00:00 (ex.: 540 = 09:00)
  endMinutes        Int
  breakStartMinutes Int? // intervalo de almoço
  breakEndMinutes   Int?

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([professionalId, weekday])
  @@index([tenantId])
}

enum ScheduleExceptionKind {
  CLOSED // folga / feriado
  CUSTOM_HOURS // horário excepcional para o dia
}

// Exceções de dia inteiro (folga ou horário diferente do padrão).
model ScheduleException {
  id             String                @id @default(cuid())
  tenantId       String
  professionalId String
  date           DateTime              @db.Date
  kind           ScheduleExceptionKind
  startMinutes   Int?
  endMinutes     Int?
  reason         String?
  createdAt      DateTime              @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([professionalId, date])
  @@index([tenantId, date])
}

enum ScheduleBlockKind {
  BLOCK // bloqueio pontual (ex.: compromisso)
  VACATION // férias (vários dias)
}

// Bloqueios por intervalo de data/hora (podem cruzar dias).
model ScheduleBlock {
  id             String            @id @default(cuid())
  tenantId       String
  professionalId String? // bloqueio do profissional, ou…
  roomId         String? // …da sala (manutenção), ou…
  resourceId     String? // …do recurso
  kind           ScheduleBlockKind @default(BLOCK)
  startsAt       DateTime
  endsAt         DateTime
  reason         String?
  createdAt      DateTime          @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  room         Room?         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  resource     Resource?     @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([tenantId, startsAt, endsAt])
  @@index([roomId, startsAt, endsAt])
  @@index([resourceId, startsAt, endsAt])
}

// ───────────────────────── Clientes ─────────────────────────

model Client {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  phone    String // E.164, ex.: +5511999998888
  email    String?
  notes    String? // observações administrativas (SPEC §12)

  birthDate               DateTime? @db.Date // aniversário → campanha (SPEC §13)
  preferredProfessionalId String?

  // Ficha técnica configurável por segmento (lib/marca.ts → fichaDe): { ["unhas.formato"]: valor, … }.
  // Atualizada automaticamente quando a profissional registra um atendimento (Appointment.registro).
  ficha                   Json?
  allergies               String? // produtos a evitar
  maintenanceIntervalDays Int? // "costuma voltar a cada 20 dias" → base da lista de reativação (SPEC §14)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  preferredProfessional Professional?     @relation("ClientPreferredProfessional", fields: [preferredProfessionalId], references: [id], onDelete: SetNull)
  appointments          Appointment[]
  messages              WhatsappMessage[]

  @@unique([tenantId, phone])
  @@index([tenantId, name])
}

// ───────────────────────── Agendamentos ─────────────────────────

enum AppointmentStatus {
  PENDING // criado, WhatsApp ainda não enviado
  AWAITING_PAYMENT // aguardando o Pix do sinal (horário reservado até expiresAt)
  AWAITING_CONFIRMATION // WhatsApp enviado, aguardando cliente
  CONFIRMED
  RESCHEDULE_REQUESTED // cliente pediu outro horário; o original segue reservado até a profissional agir
  CANCELLED_BY_CLIENT
  CANCELLED_BY_PROFESSIONAL
  COMPLETED
  NO_SHOW
}

enum AppointmentSource {
  PUBLIC // página pública
  DASHBOARD // criado pelo profissional
}

// A VISITA da cliente ao salão (SPEC §11): um status, uma confirmação, um pagamento,
// e um ou mais serviços (AppointmentItem), cada um com o próprio profissional e horário.
// startsAt/endsAt são o envelope dos itens (menor início, maior fim) — é o que a agenda,
// os lembretes e a expiração consultam, sem precisar juntar os itens.
model Appointment {
  id       String            @id @default(cuid())
  tenantId String
  clientId String
  startsAt DateTime
  endsAt   DateTime
  status   AppointmentStatus @default(PENDING)
  source   AppointmentSource @default(PUBLIC)

  // Resumo para mensagens e listagens ("Corte + Escova + Manicure").
  // durationMinutes e priceCents são TOTAIS de todos os itens (com adicionais).
  serviceName     String
  durationMinutes Int
  priceCents      Int

  notes             String? // observação do cliente
  internalNotes     String? // anotações do salão
  registro          Json? // o que foi feito nesta visita: { [codigo da ficha]: valor } (mesmos códigos de fichaDe)
  confirmationToken String    @unique
  confirmedAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  reminderSentAt    DateTime?
  expiresAt         DateTime? // quando o pendente/aguardando pagamento será liberado automaticamente

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client   Client             @relation(fields: [clientId], references: [id])
  items    AppointmentItem[]
  events   AppointmentEvent[]
  messages WhatsappMessage[]
  payment  Payment?

  @@index([tenantId, startsAt])
  @@index([clientId, startsAt])
  @@index([status, expiresAt])
  @@index([status, startsAt, reminderSentAt])
}

// Um serviço dentro da visita. É o que ocupa a agenda de UM profissional e o que gera comissão.
// Adicionais escolhidos junto entram no snapshot de duração/preço deste item.
model AppointmentItem {
  id             String   @id @default(cuid())
  tenantId       String
  appointmentId  String
  professionalId String
  serviceId      String
  startsAt       DateTime
  endsAt         DateTime
  sortOrder      Int      @default(0) // ordem em que a cliente faz os serviços

  roomId         String? // sala usada (null = serviço sem sala)

  // Snapshot no momento do agendamento (serviço + adicionais)
  serviceName     String
  durationMinutes Int
  priceCents      Int
  // Preparo/limpeza (Service.bufferBefore/After ao agendar): a sala e os recursos ficam ocupados também nesse tempo.
  bufferBeforeMinutes Int @default(0)
  bufferAfterMinutes  Int @default(0)

  // Comissão apurada quando a visita é concluída (SPEC §17). null = ainda não apurada / não comissionado.
  commissionCents  Int?
  commissionPaidAt DateTime? // quando o salão acertou esta comissão com o profissional

  createdAt DateTime @default(now())

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment  Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  professional Professional       @relation(fields: [professionalId], references: [id])
  service      Service            @relation(fields: [serviceId], references: [id])
  room         Room?              @relation(fields: [roomId], references: [id], onDelete: SetNull)
  addOns       AppointmentAddOn[]
  resources    AppointmentItemResource[]

  @@index([appointmentId, sortOrder])
  @@index([roomId, startsAt, endsAt])
  @@index([professionalId, startsAt, endsAt])
  @@index([tenantId, startsAt])
  @@index([professionalId, commissionPaidAt])
}

enum AppointmentActor {
  CLIENT
  PROFESSIONAL
  SYSTEM
}

// Histórico de alterações (auditoria)
model AppointmentEvent {
  id            String             @id @default(cuid())
  tenantId      String
  appointmentId String
  actor         AppointmentActor
  type          String // CREATED | STATUS_CHANGED | RESCHEDULED | NOTE
  fromStatus    AppointmentStatus?
  toStatus      AppointmentStatus?
  data          Json?
  createdAt     DateTime           @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
}

// ───────────────────────── WhatsApp ─────────────────────────

enum MessageKind {
  REQUEST_CONFIRMATION
  CONFIRMED
  REMINDER
  CANCELLED
  RESCHEDULED
  PAYMENT_REQUEST
  INBOUND
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

model WhatsappMessage {
  id                String           @id @default(cuid())
  tenantId          String
  appointmentId     String?
  clientId          String?
  direction         MessageDirection
  kind              MessageKind
  phone             String
  body              String
  providerMessageId String?          @unique
  status            MessageStatus    @default(QUEUED)
  error             String?
  createdAt         DateTime         @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

// Templates editáveis por tenant.
// Placeholders: {{cliente}} {{servico}} {{profissional}} {{estabelecimento}} {{data}} {{hora}} {{link}}
model MessageTemplate {
  id       String      @id @default(cuid())
  tenantId String
  kind     MessageKind
  body     String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind])
}

// ───────────────────────── Pagamentos (Pix) ─────────────────────────

enum PaymentStatus {
  PENDING // cobrança gerada, aguardando o Pix
  PAID
  EXPIRED // prazo venceu sem pagamento
  CANCELLED // cobrança cancelada antes de pagar
  REFUNDED
  FAILED
}

// Sinal (pagamento antecipado) de um agendamento. 1:1 — um agendamento tem no máximo uma cobrança.
model Payment {
  id                String        @id @default(cuid())
  tenantId          String
  appointmentId     String        @unique
  provider          String // "mock" | "mercadopago"
  providerPaymentId String?       @unique
  amountCents       Int
  status            PaymentStatus @default(PENDING)
  pixCopyPaste      String? // código "copia e cola" (EMV)
  pixQrCodeBase64   String? // imagem PNG em base64 (quando o provedor fornece)
  expiresAt         DateTime
  paidAt            DateTime?
  refundedAt        DateTime?
  error             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
}

// ───────────────────────── Portfólio (seção 13) ─────────────────────────

// Fotos dos trabalhos da profissional. As visíveis aparecem na galeria da página pública.
model PortfolioItem {
  id          String           @id @default(cuid())
  tenantId    String
  imageUrl    String
  title       String // nome do trabalho (ex.: "Mechas loiras", "Alongamento almond em fibra")
  description String?
  categoryId  String?
  visible     Boolean          @default(true)
  sortOrder   Int              @default(0)
  publishedAt DateTime         @default(now())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([tenantId, visible, sortOrder])
}
