# Produção (Coolify): as variáveis são definidas por infra/coolify-setup.mjs a partir deste modelo.
# Nunca commite um .env.production preenchido.
NODE_ENV=production
DATABASE_URL=postgresql://heeca_beauty:SENHA@heeca-beauty-db:5432/heeca_beauty?schema=public
APP_URL=https://beauty.heeca.com.br
AUTH_SECRET=
CRON_SECRET=
MIGRATE_ON_START=true
# Rotinas (lembretes / expiração) dentro do processo — instância única
CRON_INPROCESS=true

# WhatsApp: "console" até os templates da Meta serem aprovados (docs/whatsapp-meta.md)
WHATSAPP_PROVIDER=console
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# E-mail (recuperação de senha): "resend" com domínio verificado, senão "console"
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Heeca Beauty <no-reply@heeca.com.br>"

# Pix: em produção sempre "mercadopago"; cada studio salva o próprio token em Configurações → Pagamentos.
PIX_PROVIDER=mercadopago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
