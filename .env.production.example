# Produção (Coolify): as variáveis são definidas por infra/coolify-setup.mjs a partir deste modelo
# (bloco "Motor Heeca Schedule" — um app por marca, mesma imagem). Nunca commite um .env.production preenchido.
NODE_ENV=production
DATABASE_URL=postgresql://heeca_beauty:SENHA@heeca-beauty-db:5432/heeca_beauty?schema=public
# Este container serve UMA marca (beauty OU wellness); MARCA_DEFAULT diz qual. Os hosts absorvidos
# (nail/lash/brow/cut/skin → beauty; massage → wellness) redirecionam 301 para APP_URL via proxy.ts.
MARCA_DEFAULT=beauty
APP_URL=https://beauty.heeca.com.br
APP_URL_TEMPLATE=https://{marca}.heeca.com.br
AUTH_SECRET=
CRON_SECRET=
MIGRATE_ON_START=true
# Rotinas (lembretes / expiração / pacotes vencidos) dentro do processo — instância única
CRON_INPROCESS=true

# WhatsApp pelo Heeca Notify (D9): o produto nunca fala com a Meta nem guarda credenciais dela.
# NOTIFY_SECRET = NOTIFY_SECRET_<MARCA em maiúsculas> gerado pelo Heeca Notify para esta marca.
WHATSAPP_PROVIDER=notify
NOTIFY_URL=https://notify.heeca.com.br
NOTIFY_PRODUCT=beauty
NOTIFY_SECRET=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# E-mail (recuperação de senha): "resend" com domínio verificado, senão "console"
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Heeca Beauty <no-reply@heeca.com.br>"

# Pix: o único meio de pagamento é o Asaas; cada estabelecimento salva a própria chave de API em Configurações → Pagamentos.
# Sem PIX_PROVIDER no ambiente (nem chave salva), o sinal fica indisponível. ASAAS_ENV=production usa a API real.
ASAAS_ENV=production

# Imagens: upload para o bucket PÚBLICO do produto no R2 (coolify-setup.mjs → s3PublicEnv(<marca>)).
# Obrigatório em produção: STORAGE_PROVIDER=local é recusado no boot do upload (disco efêmero).
STORAGE_PROVIDER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_PUBLIC_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=beauty
