# Banco de dados (Docker Compose local)
DATABASE_URL="postgresql://heeca:heeca@localhost:5902/heeca_beauty?schema=public"

# URL pública da aplicação (usada nos links enviados por WhatsApp)
APP_URL="http://localhost:3000"

# Segredo para assinar sessões (gere com: openssl rand -base64 32)
AUTH_SECRET="troque-este-segredo-em-producao-1234567890"

# Segredo para proteger endpoints de cron (/api/cron/*)
CRON_SECRET="troque-este-segredo-cron"

# WhatsApp: "console" (dev, imprime no terminal) ou "meta" (WhatsApp Cloud API)
WHATSAPP_PROVIDER="console"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN="heeca-verify"
WHATSAPP_APP_SECRET=""

# E-mail transacional: "console" (dev, imprime no terminal) ou "resend"
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
# Remetente verificado no Resend (domínio próprio). Em testes, "onboarding@resend.dev" funciona só para o e-mail da sua conta.
EMAIL_FROM="Heeca <no-reply@seudominio.com.br>"

# WhatsApp — Meta Cloud API (WHATSAPP_PROVIDER=meta)
# ID da conta WhatsApp Business (WABA): permite ao painel listar o status dos templates
WHATSAPP_BUSINESS_ACCOUNT_ID=""
# Fora da janela de 24h a Meta só aceita templates aprovados. Padrão: true quando provider=meta.
WHATSAPP_USE_TEMPLATES=""
WHATSAPP_TEMPLATE_LANGUAGE="pt_BR"
# Nomes dos templates cadastrados na Meta (padrões em src/lib/whatsapp/meta-templates.ts)
WHATSAPP_TEMPLATE_REQUEST_CONFIRMATION=""
WHATSAPP_TEMPLATE_CONFIRMED=""
WHATSAPP_TEMPLATE_REMINDER=""
WHATSAPP_TEMPLATE_CANCELLED=""
WHATSAPP_TEMPLATE_RESCHEDULED=""

# Pix (sinal no agendamento): "mock" (dev, botão "Simular pagamento") ou "mercadopago".
# Cada estabelecimento pode salvar o próprio token em Configurações → Pagamentos;
# MERCADOPAGO_ACCESS_TOKEN é o fallback (útil em dev ou para conta única da plataforma).
PIX_PROVIDER="mock"
MERCADOPAGO_ACCESS_TOKEN=""
# Segredo do webhook (Suas integrações → Webhooks → Assinatura secreta). Opcional, mas recomendado.
MERCADOPAGO_WEBHOOK_SECRET=""

# Portal heeca.com.br (provisionamento, entitlement e SSO — contrato em heeca_site/docs/ENTITLEMENT.md)
HEECA_PLATFORM_SECRET=
HEECA_PORTAL_URL="https://heeca.com.br"
